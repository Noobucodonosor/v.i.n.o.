---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'v.i.n.o. — Valutazione e storico delle annate smartphone nuovi ma mai usati.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --ink: #1e1915;
        --muted: #5c5148;
        --accent: #722f37;
        --alert: #9e2a2b;
        --border: #e5ddd3;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.55;
      }

      main {
        max-width: 920px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
      }

      @media (min-width: 768px) {
        main {
          padding: 2rem 1.5rem 3.5rem;
        }
      }

      select,
      button,
      summary {
        min-height: 44px;
        font: inherit;
      }

      .disclosure {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        margin-bottom: 1rem;
      }

      .disclosure > summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        color: var(--accent);
        cursor: pointer;
        list-style: none;
      }

      .disclosure > summary::-webkit-details-marker {
        display: none;
      }

      .disclosure > summary::after {
        content: '▾';
        font-size: 0.9rem;
        color: var(--muted);
      }

      .disclosure[open] > summary::after {
        content: '▴';
      }

      .disclosure-body {
        padding: 0 1.25rem 1.25rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
