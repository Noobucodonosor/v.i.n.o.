---
import { formatItDate } from '../lib/scoring';
import type { MarketSnapshot } from '../schemas/offer';

interface Props {
  snapshots: MarketSnapshot[];
}

const { snapshots } = Astro.props;

// Rimuove rilevazioni consecutive identiche per evitare ridondanza (B1)
const uniqueSnapshots = snapshots.filter((snap, idx) => {
  if (idx === 0) return true;
  const prev = snapshots[idx - 1];
  return (
    snap.median_asking_eur !== prev.median_asking_eur ||
    snap.median_sold_eur !== prev.median_sold_eur ||
    snap.active_count !== prev.active_count ||
    snap.sold_count !== prev.sold_count ||
    snap.expired_count !== prev.expired_count
  );
});

const prices = uniqueSnapshots
  .flatMap((s) => [s.median_asking_eur, s.median_sold_eur])
  .filter((p): p is number => p !== null);
const maxPrice = prices.length > 0 ? Math.max(...prices) : 1;

function formatCounts(snap: MarketSnapshot): string {
  const parts: string[] = [];
  if (snap.active_count > 0) parts.push(`${snap.active_count} ${snap.active_count === 1 ? 'attiva' : 'attive'}`);
  if (snap.sold_count > 0) parts.push(`${snap.sold_count} ${snap.sold_count === 1 ? 'venduta' : 'vendute'}`);
  if (snap.expired_count > 0) parts.push(`${snap.expired_count} ${snap.expired_count === 1 ? 'scaduta' : 'scadute'}`);
  return parts.length > 0 ? parts.join(', ') : 'nessuna offerta attiva';
}
---

<section class="panel" aria-labelledby="market-chart-heading">
  <h2 id="market-chart-heading">Storico Mercato</h2>
  {uniqueSnapshots.length === 0 ? (
    <p class="empty">Nessuno snapshot storico ancora registrato per questa annata.</p>
  ) : (
    <div class="snapshots">
      {uniqueSnapshots.map((snap) => {
        const askingPct = snap.median_asking_eur ? Math.round((snap.median_asking_eur / maxPrice) * 100) : 0;
        const soldPct = snap.median_sold_eur ? Math.round((snap.median_sold_eur / maxPrice) * 100) : 0;
        return (
          <div class="snap-row">
            <span class="snap-date">{formatItDate(snap.date)}</span>
            <div class="bars">
              {snap.median_asking_eur !== null && (
                <div class="bar-wrap">
                  <span class="bar asking" style={`width: ${askingPct}%`}></span>
                  <span class="bar-label">Richiesta mediana €{snap.median_asking_eur}</span>
                </div>
              )}
              {snap.median_sold_eur !== null && (
                <div class="bar-wrap">
                  <span class="bar sold" style={`width: ${soldPct}%`}></span>
                  <span class="bar-label">Venduto mediano €{snap.median_sold_eur}</span>
                </div>
              )}
            </div>
            <span class="counts">{formatCounts(snap)}</span>
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-size: 1.15rem;
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }

  .snapshots {
    display: grid;
    gap: 0.75rem;
  }

  .snap-row {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .snap-date {
    font-weight: 600;
  }

  .bars {
    display: grid;
    gap: 0.35rem;
  }

  .bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar {
    display: inline-block;
    height: 10px;
    border-radius: 999px;
    min-width: 8px;
  }

  .bar.asking {
    background: var(--accent);
  }

  .bar.sold {
    background: #2f6b4f;
  }

  .bar-label,
  .counts {
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .snap-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
