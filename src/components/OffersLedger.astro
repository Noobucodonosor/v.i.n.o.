---
import { formatItDate } from '../lib/scoring';
import type { Offer } from '../schemas/offer';

interface Props {
  offers: Offer[];
}

const { offers } = Astro.props;

const STATUS_LABELS: Record<Offer['status'], string> = {
  active: 'Attiva',
  sold: 'Venduta',
  expired: 'Scaduta',
  unverified: 'Da verificare',
};

const SOURCE_LABELS: Record<Offer['source'], string> = {
  ebay: 'eBay',
  subito: 'Subito',
  wallapop: 'Wallapop',
  vinted: 'Vinted',
  community: 'Segnalazione verificata',
};
---

<details class="disclosure">
  <summary>Vedi storico segnalazioni ({offers.length})</summary>
  <div class="disclosure-body">
    {offers.length === 0 ? (
      <p class="empty">Nessuna offerta tracciata finora per questa annata.</p>
    ) : (
      <table class="ledger-table">
        <thead>
          <tr>
            <th>Inserzione</th>
            <th>Fonte</th>
            <th>Stato</th>
            <th>Prezzo</th>
            <th>Rilevazione</th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => {
            const firstPrice = offer.price_history[0]?.price;
            const lastPrice = offer.price_history[offer.price_history.length - 1]?.price;
            const isRepoSeed = offer.url.includes('github.com/Noobucodonosor/v.i.n.o.');
            const periodLabel =
              offer.first_seen === offer.last_seen
                ? `dal ${formatItDate(offer.first_seen)}`
                : `${formatItDate(offer.first_seen)} – ${formatItDate(offer.last_seen)}`;
            return (
              <tr>
                <td data-label="Inserzione">
                  {isRepoSeed ? (
                    <span>{offer.title}</span>
                  ) : (
                    <a href={offer.url} target="_blank" rel="noopener noreferrer">
                      {offer.title}
                    </a>
                  )}
                </td>
                <td data-label="Fonte">{SOURCE_LABELS[offer.source]}</td>
                <td data-label="Stato">{STATUS_LABELS[offer.status]}</td>
                <td data-label="Prezzo">
                  €{lastPrice}
                  {firstPrice !== lastPrice && (
                    <span class="old-price"> (da €{firstPrice})</span>
                  )}
                </td>
                <td data-label="Rilevazione">{periodLabel}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>
</details>

<style>
  .empty {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .ledger-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }

  .ledger-table th,
  .ledger-table td {
    text-align: left;
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .ledger-table th {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .ledger-table a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  .old-price {
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .ledger-table thead {
      display: none;
    }

    .ledger-table,
    .ledger-table tbody,
    .ledger-table tr,
    .ledger-table td {
      display: block;
      width: 100%;
    }

    .ledger-table tr {
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--border);
    }

    .ledger-table td {
      border-bottom: none;
      padding: 0.2rem 0;
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .ledger-table td::before {
      content: attr(data-label);
      color: var(--muted);
      font-weight: 600;
      flex-shrink: 0;
    }
  }
</style>
