---
import type { Offer } from '../schemas/offer';

interface Props {
  offers: Offer[];
}

const { offers } = Astro.props;

const STATUS_LABELS: Record<Offer['status'], string> = {
  active: 'Attiva',
  sold: 'Venduta',
  expired: 'Scaduta',
  unverified: 'Da verificare',
};
---

<section class="panel" aria-labelledby="ledger-heading">
  <h2 id="ledger-heading">Registro Offerte Persistenti</h2>
  {offers.length === 0 ? (
    <p class="empty">Nessuna offerta tracciata finora per questa annata.</p>
  ) : (
    <div class="table-wrap">
      <table class="ledger-table">
        <thead>
          <tr>
            <th>Inserzione</th>
            <th>Fonte</th>
            <th>Stato</th>
            <th>Ultimo Prezzo</th>
            <th>Periodo Tracciato</th>
          </tr>
        </thead>
        <tbody>
          {offers.map((offer) => {
            const firstPrice = offer.price_history[0]?.price;
            const lastPrice = offer.price_history[offer.price_history.length - 1]?.price;
            return (
              <tr>
                <td>
                  <a href={offer.url} target="_blank" rel="noopener noreferrer">
                    {offer.title}
                  </a>
                </td>
                <td>{offer.source}</td>
                <td>
                  <span class={`status status-${offer.status}`}>
                    {STATUS_LABELS[offer.status]}
                  </span>
                </td>
                <td>
                  €{lastPrice}
                  {firstPrice !== lastPrice && (
                    <span class="old-price"> (da €{firstPrice})</span>
                  )}
                </td>
                <td>{offer.first_seen} → {offer.last_seen}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</section>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 1.2rem;
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .ledger-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .ledger-table th,
  .ledger-table td {
    text-align: left;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .ledger-table th {
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .ledger-table a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  .status {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .status-active {
    background: #e6f4ea;
    color: #1e6b3a;
  }

  .status-sold {
    background: #ede7f6;
    color: #4a237a;
  }

  .status-expired,
  .status-unverified {
    background: #f3eee8;
    color: var(--muted);
  }

  .old-price {
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>
