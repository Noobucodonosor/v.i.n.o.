---
import { formatVintageName } from '../lib/scoring';
import type { Vintage } from '../schemas/vintage';

interface Props {
  vintages: Vintage[];
}

const { vintages } = Astro.props;
const first = vintages[0];
const second = vintages[1] ?? vintages[0];
---

<details class="disclosure">
  <summary>Confronta due annate</summary>
  <div class="disclosure-body">
    <div class="cmp-selectors">
      <label>
        <span>Annata A</span>
        <select id="cmp-select-a">
          {vintages.map((v) => (
            <option value={v.id} selected={v.id === first.id}>
              {formatVintageName(v.brand, v.model)} ({v.release_year})
            </option>
          ))}
        </select>
      </label>

      <label>
        <span>Annata B</span>
        <select id="cmp-select-b">
          {vintages.map((v) => (
            <option value={v.id} selected={v.id === second.id}>
              {formatVintageName(v.brand, v.model)} ({v.release_year})
            </option>
          ))}
        </select>
      </label>
    </div>

    <table class="cmp-table">
      <thead>
        <tr>
          <th>Metrica</th>
          <th id="cmp-name-a">{formatVintageName(first.brand, first.model)}</th>
          <th id="cmp-name-b">{formatVintageName(second.brand, second.model)}</th>
          <th>Differenza</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Metrica">Punteggio annata</td>
          <td data-label="Annata A" id="cmp-score-a">{first.vintage_score}</td>
          <td data-label="Annata B" id="cmp-score-b">{second.vintage_score}</td>
          <td data-label="Differenza" id="cmp-delta-score">{first.vintage_score - second.vintage_score}</td>
        </tr>
        <tr>
          <td data-label="Metrica">Collezionabilità</td>
          <td data-label="Annata A" id="cmp-coll-a">{first.metrics.collectibility}</td>
          <td data-label="Annata B" id="cmp-coll-b">{second.metrics.collectibility}</td>
          <td data-label="Differenza" id="cmp-delta-coll">{first.metrics.collectibility - second.metrics.collectibility}</td>
        </tr>
        <tr>
          <td data-label="Metrica">Riparabilità</td>
          <td data-label="Annata A" id="cmp-rep-a">{first.metrics.repairability}</td>
          <td data-label="Annata B" id="cmp-rep-b">{second.metrics.repairability}</td>
          <td data-label="Differenza" id="cmp-delta-rep">{first.metrics.repairability - second.metrics.repairability}</td>
        </tr>
        <tr>
          <td data-label="Metrica">Longevità software</td>
          <td data-label="Annata A" id="cmp-sw-a">{first.metrics.software_longevity}</td>
          <td data-label="Annata B" id="cmp-sw-b">{second.metrics.software_longevity}</td>
          <td data-label="Differenza" id="cmp-delta-sw">{first.metrics.software_longevity - second.metrics.software_longevity}</td>
        </tr>
        <tr>
          <td data-label="Metrica">Valore stimato</td>
          <td data-label="Annata A" id="cmp-val-a">€{first.estimated_value_eur.min}–€{first.estimated_value_eur.max}</td>
          <td data-label="Annata B" id="cmp-val-b">€{second.estimated_value_eur.min}–€{second.estimated_value_eur.max}</td>
          <td data-label="Differenza" id="cmp-delta-val">—</td>
        </tr>
      </tbody>
    </table>
  </div>
</details>

<script>
  import { compareVintages, formatVintageName } from '../lib/scoring';
  import type { Vintage } from '../schemas/vintage';

  const dataEl = document.getElementById('vintages-data');
  const vintages: Vintage[] = dataEl?.dataset.vintages ? JSON.parse(dataEl.dataset.vintages) : [];

  const selectA = document.getElementById('cmp-select-a') as HTMLSelectElement | null;
  const selectB = document.getElementById('cmp-select-b') as HTMLSelectElement | null;

  const setText = (id: string, value: string | number) => {
    const el = document.getElementById(id);
    if (el) el.textContent = String(value);
  };

  const formatDelta = (n: number, suffix = '') => (n > 0 ? `+${n}${suffix}` : `${n}${suffix}`);

  function updateComparator() {
    if (!selectA || !selectB) return;
    const a = vintages.find((v) => v.id === selectA.value);
    const b = vintages.find((v) => v.id === selectB.value);
    if (!a || !b) return;

    const cmp = compareVintages(a, b);
    setText('cmp-name-a', formatVintageName(a.brand, a.model));
    setText('cmp-name-b', formatVintageName(b.brand, b.model));

    setText('cmp-score-a', a.vintage_score);
    setText('cmp-score-b', b.vintage_score);
    setText('cmp-delta-score', formatDelta(cmp.scoreDelta));

    setText('cmp-coll-a', a.metrics.collectibility);
    setText('cmp-coll-b', b.metrics.collectibility);
    setText('cmp-delta-coll', formatDelta(cmp.collectibilityDelta));

    setText('cmp-rep-a', a.metrics.repairability);
    setText('cmp-rep-b', b.metrics.repairability);
    setText('cmp-delta-rep', formatDelta(cmp.repairabilityDelta));

    setText('cmp-sw-a', a.metrics.software_longevity);
    setText('cmp-sw-b', b.metrics.software_longevity);
    setText('cmp-delta-sw', formatDelta(cmp.softwareLongevityDelta));

    setText('cmp-val-a', `€${a.estimated_value_eur.min}–€${a.estimated_value_eur.max}`);
    setText('cmp-val-b', `€${b.estimated_value_eur.min}–€${b.estimated_value_eur.max}`);
    setText('cmp-delta-val', formatDelta(cmp.midpointValueDeltaEur, ' € sulla mediana'));
  }

  selectA?.addEventListener('change', updateComparator);
  selectB?.addEventListener('change', updateComparator);
  updateComparator();
</script>

<style>
  .cmp-selectors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .cmp-selectors label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .cmp-selectors select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
  }

  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .cmp-table th,
  .cmp-table td {
    text-align: left;
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cmp-table th {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .cmp-table thead {
      display: none;
    }

    .cmp-table,
    .cmp-table tbody,
    .cmp-table tr,
    .cmp-table td {
      display: block;
      width: 100%;
    }

    .cmp-table tr {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .cmp-table td {
      border-bottom: none;
      padding: 0.2rem 0;
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .cmp-table td::before {
      content: attr(data-label);
      color: var(--muted);
      font-weight: 600;
    }
  }
</style>
