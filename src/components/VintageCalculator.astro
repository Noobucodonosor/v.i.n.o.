---
import { formatItDate, formatVintageName } from '../lib/scoring';
import type { Vintage } from '../schemas/vintage';

interface Props {
  vintages: Vintage[];
  updatedAt: string;
}

const { vintages, updatedAt } = Astro.props;
const defaultVintage = vintages[0];
const formattedDate = formatItDate(updatedAt);
---

<section class="panel" aria-labelledby="calc-heading">
  <h2 id="calc-heading">Valuta un'annata</h2>

  <form id="vintage-calc-form" class="controls">
    <label class="primary-field">
      <span>Modello e annata</span>
      <select name="vintageId" id="calc-vintage">
        {vintages.map((v) => (
          <option value={v.id}>
            {formatVintageName(v.brand, v.model)} ({v.release_year})
          </option>
        ))}
      </select>
    </label>

    <details class="calc-refine">
      <summary>Affina stato e conservazione</summary>
      <div class="refine-grid">
        <label>
          <span>Stato sigillo</span>
          <select name="sealState" id="calc-seal">
            <option value="sealed_mint">Sigillato intatto</option>
            <option value="sealed_shelf_wear">Sigillato con segni da scaffale</option>
            <option value="nos_open_box">Scatola aperta, mai acceso</option>
          </select>
        </label>

        <label>
          <span>Conservazione</span>
          <select name="storageEnv" id="calc-storage">
            <option value="controlled">Ambiente fresco e asciutto</option>
            <option value="unknown" selected>Sconosciuta o standard</option>
            <option value="warm">Ambiente caldo o umido</option>
          </select>
        </label>

        <label>
          <span>Corredo scatola</span>
          <select name="boxCompleteness" id="calc-box">
            <option value="complete">Completo (accessori originali)</option>
            <option value="partial">Incompleto o solo telefono</option>
          </select>
        </label>
      </div>
    </details>
  </form>

  <div class="result-block" aria-live="polite" data-updated={formattedDate}>
    <div class="headline-metrics">
      <p class="score-line">
        <strong class="score" id="calc-score">{defaultVintage.vintage_score}</strong><span class="unit">/100</span>
        <span class="sep">·</span>
        <span class="grade" id="calc-grade">{defaultVintage.vintage_grade}</span>
      </p>
      <p class="price" id="calc-price">
        €{defaultVintage.estimated_value_eur.min}–€{defaultVintage.estimated_value_eur.max}
      </p>
    </div>

    <p class="synthesis" id="calc-warning">
      Rischio batteria {defaultVintage.metrics.battery_risk.toLowerCase()} · Rilevazione {formattedDate}
    </p>
    <p class="summary" id="calc-summary">{defaultVintage.tasting_notes.summary}</p>
  </div>
</section>

<script>
  import { calculateVintageValuation, type CalculatorInput } from '../lib/scoring';
  import type { Vintage } from '../schemas/vintage';

  const dataEl = document.getElementById('vintages-data');
  const vintages: Vintage[] = dataEl?.dataset.vintages ? JSON.parse(dataEl.dataset.vintages) : [];

  const form = document.getElementById('vintage-calc-form') as HTMLFormElement | null;
  const selectVintage = document.getElementById('calc-vintage') as HTMLSelectElement | null;
  const selectSeal = document.getElementById('calc-seal') as HTMLSelectElement | null;
  const selectStorage = document.getElementById('calc-storage') as HTMLSelectElement | null;
  const selectBox = document.getElementById('calc-box') as HTMLSelectElement | null;

  const resultBlock = document.querySelector('.result-block') as HTMLElement | null;
  const updatedAt = resultBlock?.dataset.updated || '';

  const outScore = document.getElementById('calc-score');
  const outGrade = document.getElementById('calc-grade');
  const outPrice = document.getElementById('calc-price');
  const outSummary = document.getElementById('calc-summary');
  const outWarning = document.getElementById('calc-warning');

  function updateCalculator() {
    if (!selectVintage || !selectSeal || !selectStorage || !selectBox) return;
    const selected = vintages.find((v) => v.id === selectVintage.value);
    if (!selected) return;

    const input: CalculatorInput = {
      sealState: selectSeal.value as CalculatorInput['sealState'],
      storageEnv: selectStorage.value as CalculatorInput['storageEnv'],
      boxCompleteness: selectBox.value as CalculatorInput['boxCompleteness'],
    };

    const result = calculateVintageValuation(selected, input);
    if (outScore) outScore.textContent = String(result.adjustedScore);
    if (outGrade) outGrade.textContent = result.grade;
    if (outPrice) {
      outPrice.textContent = `€${result.estimatedValueEur.min}–€${result.estimatedValueEur.max} (mediana €${result.estimatedValueEur.midpoint})`;
    }
    if (outSummary) outSummary.textContent = selected.tasting_notes.summary;
    if (outWarning) {
      const isAlert = selected.metrics.battery_risk === 'Alto' || input.storageEnv === 'warm';
      outWarning.classList.toggle('is-alert', isAlert);
      outWarning.textContent = `${result.batteryWarning} · Rilevazione ${updatedAt}`;
    }
  }

  form?.addEventListener('change', updateCalculator);
  updateCalculator();
</script>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    color: var(--accent);
  }

  .controls {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .primary-field,
  .refine-grid label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
  }

  .calc-refine summary {
    display: inline-flex;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
    min-height: 44px;
  }

  .refine-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .result-block {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .headline-metrics {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }

  .score-line {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .score {
    font-size: 2rem;
    color: var(--accent);
    line-height: 1;
  }

  .unit {
    color: var(--muted);
    font-weight: 500;
  }

  .sep {
    margin: 0 0.35rem;
    color: var(--muted);
  }

  .grade {
    color: var(--ink);
  }

  .price {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .synthesis {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .synthesis.is-alert {
    color: var(--alert);
    font-weight: 600;
  }

  .summary {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink);
  }
</style>
