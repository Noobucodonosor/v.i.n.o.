---
import Layout from '../../layouts/Layout.astro';
import MarketChart from '../../components/MarketChart.astro';
import OffersLedger from '../../components/OffersLedger.astro';
import rawVintages from '../../data/vintages.json';
import rawOffers from '../../data/offers.json';
import rawHistory from '../../data/market-history.json';
import { formatItDate, formatVintageName } from '../../lib/scoring';
import { VintagesDatasetSchema, type Vintage } from '../../schemas/vintage';
import { MarketHistorySchema, OffersLedgerSchema } from '../../schemas/offer';

export function getStaticPaths() {
  const dataset = VintagesDatasetSchema.parse(rawVintages);
  return dataset.vintages.map((vintage) => ({
    params: { slug: vintage.id },
    props: { vintage },
  }));
}

interface Props {
  vintage: Vintage;
}

const { vintage } = Astro.props;
const offersLedger = OffersLedgerSchema.parse(rawOffers);
const marketHistory = MarketHistorySchema.parse(rawHistory);

const vintageOffers = offersLedger.offers.filter((o) => o.vintage_id === vintage.id);
const vintageSnapshots = marketHistory.series[vintage.id] ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const displayName = formatVintageName(vintage.brand, vintage.model);
---

<Layout title={`${displayName} (${vintage.release_year}) — v.i.n.o.`}>
  <nav class="breadcrumb">
    <a href={`${base}/`}>← Torna al calcolatore</a>
  </nav>

  <header class="vintage-header">
    <div>
      <h1>{displayName} ({vintage.release_year})</h1>
      <p class="synthesis">
        <strong>{vintage.vintage_score}/100 · {vintage.vintage_grade}</strong> — valore stimato
        €{vintage.estimated_value_eur.min}–€{vintage.estimated_value_eur.max}; collezione
        {vintage.metrics.collectibility}/100, longevità software {vintage.metrics.software_longevity}/100,
        riparabilità {vintage.metrics.repairability}/100 e rischio batteria {vintage.metrics.battery_risk.toLowerCase()}.
      </p>
      <p class="summary">{vintage.tasting_notes.summary}</p>
      <p class="freshness">Rilevazione dati: {formatItDate(vintage.last_updated)}</p>
    </div>
  </header>

  <MarketChart snapshots={vintageSnapshots} />
  <OffersLedger offers={vintageOffers} />
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .vintage-header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    line-height: 1.15;
  }

  .synthesis {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: var(--ink);
  }

  .summary {
    margin: 0 0 0.4rem;
    color: var(--muted);
    max-width: 64ch;
  }

  .freshness {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
  }
</style>
