---
import Layout from '../layouts/Layout.astro';
import VintageCalculator from '../components/VintageCalculator.astro';
import VintageComparator from '../components/VintageComparator.astro';
import rawVintages from '../data/vintages.json';
import { VintagesDatasetSchema } from '../schemas/vintage';

const dataset = VintagesDatasetSchema.parse(rawVintages);
---

<Layout title="v.i.n.o. — Annate Smartphone New Old Stock">
  <header class="hero">
    <p class="eyebrow">Vintage Index for New Old-stock</p>
    <h1>v.i.n.o.</h1>
    <p class="lead">
      Gli smartphone nuovi ma mai usati sono come il vino: non invecchiano tutti allo stesso modo, ed esistono buone annate.
    </p>
  </header>

  <div id="vintages-data" data-vintages={JSON.stringify(dataset.vintages)} hidden></div>

  <VintageCalculator vintages={dataset.vintages} />
  <VintageComparator vintages={dataset.vintages} />
</Layout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
  }
</style>
