---
import Layout from '../layouts/Layout.astro';
import VintageCalculator from '../components/VintageCalculator.astro';
import VintageComparator from '../components/VintageComparator.astro';
import rawVintages from '../data/vintages.json';
import { VintagesDatasetSchema } from '../schemas/vintage';

const dataset = VintagesDatasetSchema.parse(rawVintages);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="v.i.n.o. — Annate Smartphone New Old Stock">
  <header class="hero">
    <p class="eyebrow">Vintage Index for New Old-stock</p>
    <h1>v.i.n.o.</h1>
    <p class="lead">
      Gli smartphone nuovi ma mai usati sono come il vino: non invecchiano tutti allo stesso modo, ed esistono buone annate.
    </p>
  </header>

  <div id="vintages-data" data-vintages={JSON.stringify(dataset.vintages)} hidden></div>

  <VintageCalculator vintages={dataset.vintages} />
  <VintageComparator vintages={dataset.vintages} />

  <section class="catalog" aria-labelledby="catalog-heading">
    <h2 id="catalog-heading">Catalogo Annate &amp; Mercato</h2>
    <div class="catalog-grid">
      {dataset.vintages.map((v) => (
        <a class="vintage-card" href={`${base}/vintage/${v.id}/`}>
          <div class="card-top">
            <span class="year">{v.release_year}</span>
            <span class="grade-pill">{v.vintage_grade}</span>
          </div>
          <h3>{v.brand} {v.model}</h3>
          <p class="card-meta">Punteggio: <strong>{v.vintage_score}/100</strong> · €{v.estimated_value_eur.min}–€{v.estimated_value_eur.max}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
  }

  .catalog h2 {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .vintage-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.15rem;
    color: inherit;
    text-decoration: none;
  }

  .vintage-card:hover {
    border-color: var(--accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
  }

  .year {
    font-weight: 700;
    color: var(--muted);
  }

  .grade-pill {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .vintage-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .card-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
